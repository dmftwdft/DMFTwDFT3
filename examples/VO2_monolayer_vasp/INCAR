System     = VO2_monolayer
ENCUT      = 600.0
NBANDS     = 40
EDIFF      = 1E-6
GGA        = PS
IALGO      = 48
LMAXMIX    = 4
ADDGRID    = .TRUE.
ISPIN      = 1
NCORE      = 1
LWANNIER90 = .TRUE.

